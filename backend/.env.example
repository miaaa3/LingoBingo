# Copy to .env and fill in real values. .env is gitignored.
# Generate a strong secret, e.g.: openssl rand -base64 48
SECRET_KEY=change-me-to-a-long-random-value
DB_URL=jdbc:mysql://localhost:3306/QuizDB
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
CORS_ALLOWED_ORIGINS=http://localhost:4200
